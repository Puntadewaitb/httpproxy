{
  "name": "@proxykit/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env PROXYKIT_DEV_URL=http://localhost:5173 electron .\"",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@proxykit/core": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "wait-on": "^9.0.0"
  }
}
